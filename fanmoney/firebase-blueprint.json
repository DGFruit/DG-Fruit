{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and balance information.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The unique ID of the user." },
        "email": { "type": "string", "format": "email", "description": "User's email address." },
        "username": { "type": "string", "description": "Unique @handle for the user." },
        "displayName": { "type": "string", "description": "User's display name." },
        "photoURL": { "type": "string", "description": "User's profile picture URL." },
        "balance": { "type": "number", "description": "Current wallet balance." },
        "streakCount": { "type": "number", "description": "Current saving streak in days." },
        "lastStreakUpdate": { "type": "string", "format": "date-time", "description": "Last time streak was updated." },
        "badges": { "type": "array", "items": { "type": "string" }, "description": "Earned achievement badges." },
        "friends": { "type": "array", "items": { "type": "string" }, "description": "List of friend UIDs." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Account creation date." }
      },
      "required": ["uid", "email", "balance"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Income or expense record.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The ID of the user who owns this transaction." },
        "amount": { "type": "number", "description": "Transaction amount." },
        "type": { "type": "string", "enum": ["income", "expense"], "description": "Type of transaction." },
        "category": { "type": "string", "description": "Category (e.g., Food, Entertainment, Salary)." },
        "date": { "type": "string", "format": "date-time", "description": "When the transaction occurred." },
        "description": { "type": "string", "description": "Optional note." },
        "isRoundup": { "type": "boolean", "description": "Whether this was a roundup transaction." }
      },
      "required": ["uid", "amount", "type", "category", "date"]
    },
    "Goal": {
      "title": "Goal",
      "description": "Savings target setting.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The ID of the creator." },
        "title": { "type": "string", "description": "Goal name (e.g., New Phone)." },
        "targetAmount": { "type": "number", "description": "Target savings amount." },
        "currentAmount": { "type": "number", "description": "Currently saved amount." },
        "deadline": { "type": "string", "format": "date-time", "description": "Target date to reach the goal." },
        "status": { "type": "string", "enum": ["active", "completed", "cancelled"], "description": "Current status of the goal." },
        "imageUrl": { "type": "string", "description": "Optional custom goal image." },
        "isShared": { "type": "boolean", "description": "Whether this is a squad goal." },
        "collaborators": { "type": "array", "items": { "type": "string" }, "description": "List of collaborator UIDs." }
      },
      "required": ["uid", "title", "targetAmount", "currentAmount", "status"]
    },
    "Message": {
      "title": "Message",
      "description": "Chat message between friends.",
      "type": "object",
      "properties": {
        "senderId": { "type": "string", "description": "UID of the sender." },
        "receiverId": { "type": "string", "description": "UID of the receiver." },
        "text": { "type": "string", "description": "Message content." },
        "timestamp": { "type": "string", "format": "date-time", "description": "When the message was sent." }
      },
      "required": ["senderId", "receiverId", "text", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile documents."
    },
    "/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "User transaction records."
    },
    "/goals/{goalId}": {
      "schema": "Goal",
      "description": "User savings goals."
    },
    "/messages/{messageId}": {
      "schema": "Message",
      "description": "Chat messages."
    }
  }
}
