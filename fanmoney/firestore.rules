// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: users
// Document ID: {userId}
// Fields:
//   - uid: string (required) - User's unique ID
//   - email: string (required) - User's email
//   - username: string (optional) - Unique @handle
//   - displayName: string (optional) - User's name
//   - photoURL: string (optional) - User's photo
//   - balance: number (required) - Current balance
//   - streakCount: number (optional) - Current streak
//   - badges: list (optional) - Earned badges
//   - friends: list (optional) - Friend UIDs
//   - createdAt: timestamp (optional) - Account creation time
//
// Collection: transactions
// Document ID: {transactionId}
// Fields:
//   - uid: string (required) - Owner's UID
//   - amount: number (required) - Amount
//   - type: string (required) - "income" | "expense"
//   - category: string (required) - Category
//   - date: timestamp (required) - Transaction time
//   - description: string (optional) - Note
//
// Collection: goals
// Document ID: {goalId}
// Fields:
//   - uid: string (required) - Owner's UID
//   - title: string (required) - Goal name
//   - targetAmount: number (required) - Target
//   - currentAmount: number (required) - Current progress
//   - deadline: timestamp (optional) - Target date
//   - status: string (required) - "active" | "completed" | "cancelled"
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.uid;
    }

    function isRequestOwner() {
      return isAuthenticated() && request.auth.uid == request.resource.data.uid;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'balance', 'displayName']) &&
             data.uid is string &&
             data.email is string &&
             data.balance is number &&
             data.displayName is string;
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['uid', 'amount', 'type', 'category', 'date']) &&
             data.uid is string &&
             data.amount is number &&
             data.type in ['income', 'expense'] &&
             data.category is string &&
             data.category.size() < 100 &&
             data.date is timestamp;
    }

    function isValidGoal(data) {
      return data.keys().hasAll(['uid', 'title', 'targetAmount', 'currentAmount', 'status', 'deadline']) &&
             data.uid is string &&
             data.title is string &&
             data.title.size() < 100 &&
             data.targetAmount is number &&
             data.currentAmount is number &&
             data.status in ['active', 'completed', 'cancelled'] &&
             data.deadline is string;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data);
    }

    match /transactions/{transactionId} {
      allow read: if isDocOwner();
      allow create: if isRequestOwner() && isValidTransaction(request.resource.data);
      allow update: if isDocOwner() && isRequestOwner() && isValidTransaction(request.resource.data);
      allow delete: if isDocOwner();
    }

    match /goals/{goalId} {
      allow read: if isDocOwner();
      allow create: if isRequestOwner() && isValidGoal(request.resource.data);
      allow update: if isDocOwner() && isRequestOwner() && isValidGoal(request.resource.data);
      allow delete: if isDocOwner();
    }
  }
}
